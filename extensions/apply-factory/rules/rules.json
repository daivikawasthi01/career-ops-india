{
  "_doc": "Single source of truth for what the apply extension may read, fill and learn. The server reads it; the extension fetches it from /rules. Patterns are case-insensitive regular expressions matched against the field label, name and placeholder.",

  "never_read": [
    "pass(word|code)", "\\botp\\b", "one[- ]?time", "verification code", "\\bcvv\\b", "\\bcvc\\b",
    "card (number|no)", "credit card", "debit card", "aadhaar|aadhar", "\\bpan (card|number|no)\\b",
    "passport", "\\bssn\\b", "social security", "bank account", "\\bifsc\\b", "routing number",
    "captcha", "security (question|answer)", "secret"
  ],

  "manual_only": [
    "\\bi (agree|accept|consent|acknowledge|confirm|certify)\\b", "terms (and|&) conditions", "privacy (policy|notice)",
    "e-?signature", "\\bsignature\\b", "declaration", "i understand"
  ],

  "sensitive": [
    "gender", "\\bsex\\b", "\\brace\\b", "ethnic", "disab", "veteran", "religio", "caste", "marital", "sexual orientation",
    "pronoun", "transgender", "salary", "compensation", "\\bctc\\b", "expected pay", "current pay", "sponsor", "\\bvisa\\b",
    "work authori", "legally (authori|permitted)", "criminal", "convict", "background check", "date of birth", "\\bdob\\b",
    "birth date", "notice period", "relocat"
  ],

  "submit_text": "^\\s*(submit( application)?|apply( now)?|send( application)?|finish|done|complete( application)?|next|continue|save (and|&) continue|review( and submit)?|save (and|&) next)\\s*$",

  "guarded_sites": {
    "linkedin.com": "watch",
    "naukri.com": "watch",
    "indeed.com": "watch",
    "glassdoor.com": "off",
    "glassdoor.co.in": "off"
  },

  "ats_sites": [
    "greenhouse.io", "lever.co", "ashbyhq.com", "myworkdayjobs.com", "workday.com", "smartrecruiters.com", "icims.com",
    "jobvite.com", "recruitee.com", "workable.com", "breezy.hr", "bamboohr.com", "darwinbox.in", "darwinbox.com",
    "taleo.net", "successfactors.com", "successfactors.eu", "oraclecloud.com", "eightfold.ai", "pinpointhq.com",
    "teamtailor.com", "personio.com", "rippling.com", "zohorecruit.com", "keka.com", "freshteam.com",
    "docs.google.com/forms", "forms.gle", "typeform.com", "airtable.com", "cutshort.io", "wellfound.com", "hirist.tech",
    "instahyre.com", "unstop.com", "internshala.com", "careers.servicenow.com"
  ],

  "generic": {
    "_doc": "The content script is loaded on every https page but stays inert unless the page is an application: a listed site, a URL that reads like one, or (whatever the URL) a page with min_fields readable fields of which min_cue_fields ask application questions (field_cues). never_hosts are never touched.",
    "enabled": true,
    "url_hints": "apply|application|candidate|careers?|jobs?|requisition|recruit|onboard|signup|register|profile|workday|talent",
    "never_hosts": ["google.com", "youtube.com", "facebook.com", "instagram.com", "x.com", "twitter.com", "web.whatsapp.com", "github.com", "paypal.com", "amazon.com", "amazon.in", "flipkart.com", "stackoverflow.com"],
    "poll_minutes": 15,
    "min_fields": 3,
    "min_cue_fields": 2,
    "field_cues": "resume|\\bcv\\b|curriculum|job title|company name|employer|work experience|employment|education|university|college|institut|degree|cgpa|\\bgpa\\b|graduation|notice period|\\bctc\\b|expected (salary|pay)|linkedin|github|portfolio|cover letter|authori[sz]ed to work|sponsorship|years of experience|role description|skills|how did you hear|referr|nationality|veteran|disability|gender|date available|start date"
  },

  "page_cues": [
    "apply (now|for this)", "application form", "submit (your )?application", "upload (your )?(resume|cv)",
    "cover letter", "work experience", "years of experience", "notice period", "current ctc"
  ],

  "autocomplete_facts": {
    "given-name": "first_name", "family-name": "last_name", "name": "full_name", "email": "email", "tel": "phone",
    "tel-national": "phone_national", "address-level2": "city", "address-level1": "state", "country-name": "country",
    "country": "country", "postal-code": "postal_code", "street-address": "address_line1", "address-line1": "address_line1",
    "organization": "current_company", "url": "portfolio"
  },

  "fact_patterns": [
    { "fact": "first_name", "re": "^(legal |preferred )?(first|given) name\\b|^forename" },
    { "fact": "last_name", "re": "^(legal )?(last|family|sur) ?name\\b" },
    { "fact": "full_name", "re": "^(full|legal|your) name\\b|^name$|^candidate name" },
    { "fact": "email", "re": "e-?mail" },
    { "fact": "phone", "re": "phone|mobile|contact (no|number)|whatsapp" },
    { "fact": "linkedin", "re": "linkedin" },
    { "fact": "github", "re": "github" },
    { "fact": "leetcode", "re": "leetcode" },
    { "fact": "portfolio", "re": "portfolio|personal (web)?site|website|blog" },
    { "fact": "city", "re": "^(current )?(city|town)\\b|city of residence|current location|where are you (based|located)" },
    { "fact": "state", "re": "^(current )?(state|province)\\b" },
    { "fact": "country", "re": "^country( of residence)?$|country you (live|reside)" },
    { "fact": "nationality", "re": "nationality|citizen(ship)? of|are you an? .*citizen" },
    { "fact": "college", "re": "(college|university|institute|school) name|^(college|university|institution)\\b|name of (your )?(college|university)|where did you (study|graduate)" },
    { "fact": "degree", "re": "^degree\\b|highest (level of )?(education|qualification)|qualification|level of education" },
    { "fact": "branch", "re": "branch|major|field of study|specializ|discipline|stream" },
    { "fact": "graduation_year", "re": "(graduation|passing|pass[- ]?out|completion) year|year of (graduation|passing|completion)|expected graduation" },
    { "fact": "cgpa", "re": "cgpa|gpa|grade point|aggregate|percentage|marks" },
    { "fact": "years_experience", "re": "(total|relevant)? ?(years? of )?(work )?experience|years of exp" },
    { "fact": "current_company", "re": "current (company|employer|organi[sz]ation)|present employer" },
    { "fact": "current_title", "re": "current (job )?(title|role|designation)" },
    { "fact": "work_authorization", "re": "authori[sz]ed to work|legally (authori[sz]ed|permitted)|eligible to work|right to work" },
    { "fact": "needs_sponsorship", "re": "sponsorship|require.*visa|need.*visa" },
    { "fact": "expected_ctc", "re": "expected (ctc|salary|compensation|pay)|salary expectation|desired (salary|ctc)" },
    { "fact": "notice_period", "re": "notice period|how soon can you join|earliest (start|joining)|joining (time|date)" },
    { "fact": "relocate", "re": "willing(ness)? to relocate|open to relocat|relocate" },
    { "fact": "referral", "re": "how did you (hear|find|learn)|referr?ed by|source of application" }
  ],

  "option_aliases": [
    ["india", "indian", "in", "ind", "republic of india", "bharat", "+91", "india (+91)", "india +91"],
    ["yes", "y", "true", "yeah", "i do", "i am", "i have"],
    ["no", "n", "false", "nope", "i do not", "i don't", "i am not", "i have not", "none"],
    ["btech", "b tech", "b.tech", "bachelor of technology", "bachelors of technology", "bachelor technology", "be/btech", "b.e./b.tech", "be btech", "b.e / b.tech"],
    ["be", "b.e", "b.e.", "bachelor of engineering", "bachelors of engineering"],
    ["mtech", "m tech", "m.tech", "master of technology", "masters of technology"],
    ["bachelors", "bachelor's", "bachelor's degree", "bachelors degree", "undergraduate", "ug", "graduate"],
    ["masters", "master's", "master's degree", "masters degree", "postgraduate", "pg"],
    ["information technology", "it", "i.t.", "b.tech it", "btech it"],
    ["computer science", "cs", "cse", "computer science and engineering", "computer science & engineering"],
    ["linkedin", "linked in", "linkedin job board", "via linkedin"],
    ["company website", "careers page", "company career page", "corporate website", "career site", "company site"],
    ["haryana", "hr"],
    ["delhi", "new delhi", "delhi ncr", "nct of delhi"]
  ],

  "resume_roles": {
    "ai": {
      "label": "AI role",
      "title": ["\\bai\\b", "\\bml\\b", "machine learning", "\\bllm\\b", "gen ?ai", "generative", "deep learning", "\\bnlp\\b", "data scientist", "applied scientist", "research engineer", "mlops"],
      "jd_terms": ["pytorch", "tensorflow", "llm", "rag", "transformer", "embedding", "fine-tun", "langchain", "vector database", "machine learning", "nlp", "hugging face", "prompt", "neural network"],
      "jd_min_terms": 5,
      "not_in_title": ["software", "backend", "back-end", "frontend", "front-end", "full.?stack", "\\bsde\\b", "developer"]
    },
    "devops": {
      "label": "DevOps role",
      "title": ["devops", "\\bsre\\b", "site reliability", "platform engineer", "cloud engineer", "infrastructure engineer", "infra engineer", "release engineer", "systems engineer"],
      "jd_terms": ["kubernetes", "terraform", "ansible", "helm", "prometheus", "grafana", "ci/cd", "jenkins", "github actions", "docker", "aws", "infrastructure as code", "observability", "incident"],
      "jd_min_terms": 6,
      "not_in_title": ["software", "backend", "back-end", "frontend", "front-end", "full.?stack", "\\bsde\\b", "developer"]
    }
  },

  "banned_in_answers": ["passionate", "results-oriented", "proven track record", "leverag", "spearhead", "synerg", "robust", "seamless", "cutting-edge", "innovative", "best practices", "demonstrated ability", "fast-paced", "certainly", "absolutely", "i am excited to", "i'm excited to"],

  "answer_length": [
    { "re": "cover letter|message (to|for) (the )?(hiring|recruit)|note to (the )?(hiring|recruit)|introduce yourself|tell us about yourself|about yourself|anything else|additional information|why (do you want|are you interested|should we|this (role|company))|motivation", "min": 100, "max": 180 },
    { "re": "experience|project|describe|explain|achievement|challenge|accomplish|responsibilit|walk us through|tell us about|worked on|skills", "min": 70, "max": 150 },
    { "re": ".", "min": 40, "max": 110, "textarea_only": true }
  ],

  "thresholds": {
    "semantic_match": 0.86,
    "option_fuzzy": 0.78,
    "option_llm_below": 0.7,
    "draft_min_label_chars": 40,
    "style_examples": 4
  }
}
