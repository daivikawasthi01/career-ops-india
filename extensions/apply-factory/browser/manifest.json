{
  "manifest_version": 3,
  "name": "Apply",
  "version": "0.3.0",
  "description": "Fills job application forms from your own earlier answers, and learns the ones you type. Runs only on application sites. Never presses Submit.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Apply",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel/*",
        "shared/*"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content/core.js",
        "content/widgets.js",
        "content/capture.js",
        "content/suggest.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
